(defcfg
  log-layer-changes no
  rapid-event-delay 2         ;; adds a certain delay(ms) to have kanata processor output keys in correct order
  process-unmapped-keys no
  block-unmapped-keys no

  danger-enable-cmd yes
  delegate-to-first-layer yes  ;; transparent keys(_) delegate to first-layer only if layer-switch is used to activate the layer
  concurrent-tap-hold no
)

(include tltr_config.kbd)

;;;; TLTR Activation
;; implementation 1
#| (defchords tl_tr 500
  (tl  ) (layer-while-held TL)
  (  tr) (layer-while-held TR)
  (tl tr) (layer-while-held TLTR)
)
(defalias
  tl (chord tl_tr tl)
  tr (chord tl_tr tr)
) |#
;;implementation 2
#| (defalias
  tl (multi nop3 (switch
    (nop4) (layer-while-held TLTR) break
    () (multi (release-layer TLTR) (layer-while-held TL)) break
  ))
  tr (multi nop4 (switch
    (nop3) (layer-while-held TLTR) break
    () (multi (release-layer TLTR) (layer-while-held TR)) break
  ))
) |#
;; implementation 3
(defvirtualkeys
  release_layer_TLTR (release-layer TLTR)
)
(defalias
  tl     (multi (layer-while-held TL)                         (on-release press-vkey release_layer_TLTR))
  tltltr (multi (layer-while-held TL) (layer-while-held TLTR) (on-release press-vkey release_layer_TLTR))
  tr     (multi (layer-while-held TR)                         (on-release press-vkey release_layer_TLTR))
  trtltr (multi (layer-while-held TR) (layer-while-held TLTR) (on-release press-vkey release_layer_TLTR))
)

(defvar
  cw_timeout 3000
)
(defalias
  ;; ANSI US keycodes shifted
  und S-‐ que S-/
  ;; forks
  delf (fork ⌫ (unshift ⌦) (‹⇧))
  slaf (fork / (unshift \) (‹⇧))
  comf (fork , @und (‹⇧))
  dotf (fork . @que (‹⇧))
  ;; caps-word
  cw (caps-word-custom $cw_timeout
    (a b c d e f g h i j k l m n o p q r s t u v w x y z) ;; to be shifted
    (1 2 3 4 5 6 7 8 9 0 ▲ ▼ ◀ ▶ ⌫ ⌦ ‐ ‹⇧ ⇧›)  ;; ignore
  )
  ;; tap-dance shift: tap once = shift, tap twice = caps word
  sft (tap-dance 200 (‹⇧ @cw))
  rf13 (tap-dance 200 (C-f13 C-S-f13))
  lf19 (tap-dance 200 (f19 C-f19))
)
#|
 Custom Colemak with,
 1. curl mod (Mod-DH)
 2. wide mod (sliding right hand keys to the right by one key)
 3. angle mod (sliding keys to left & right on the bottom-most row with z being on lshft & / on rshft)
|#
(deflayer CUSTOM_COLEMAK
  @rf13 q  w  f  p  b      j   l  u     y    '     ;
  @delf a  r  s  t  g      m  n  e     i     o    _
       z  x  c  d  v        k  h @comf @dotf @slaf
           @tl @sft          spc  @tr
)

(defvar
  os_timeout 300
)
(defalias
  ;; chords
  btb S-↹
  ;; sticky/one-shot modifiers
  sAlt (one-shot-release $os_timeout ‹⌥)
  sCtl (one-shot-release $os_timeout ‹⌃)
  sSft (one-shot-release $os_timeout ‹⇧)
  sMet (one-shot-release $os_timeout ‹◆)
  sFn (one-shot-release $os_timeout nop0)
  sWin f16                                  ;; window-manager key (Hammerspoon pseudo-modifier)
  mou f17                                   ;; pointer mode (Hammerspoon pseudo-modifier)
  sHyp (multi @sAlt @sCtl @sSft @sMet)   ;; hyper key
  ;; forks
  pguf (fork ⇞ (unshift ⤒) (‹⇧))
  pgdf (fork ⇟ (unshift ⤓) (‹⇧))
)

;; TL (Thumb Left) layer
;; for modifiers & navigation
(deflayer TL
  lrld   ⎋     f16   f17   f18   XX       @pguf   @btb   ▲   ↹   XX  XX
  _    @sAlt @sCtl @sSft @sMet @sFn     @pgdf    ◀     ▼   ▶   XX   _
      @lf19   XX    XX   @sHyp XX        XX      ⌫     ⌦   XX  _
                   XX  _                       _ @trtltr
)

(defalias
  hpn (unshift ‐) equ (unshift ₌)
  hpnf (fork @hpn (unicode –) (‹⇧))
  equf (fork @equ (unicode —) (‹⇧))
  ;; ANSI US keycodes shifted
  til S-ˋ exc S-1 ats S-2 oct S-3 dol S-4 per S-5 car S-6 amp S-7 ast S-8 pao S-9 pac S-0 plu S-₌
  cuo S-[ cuc S-] pip S-\ ano S-, anc S-.
  ;; symbols' forks
  excf (fork @exc (unshift ˋ) (‹⇧))
  atsf (fork @ats @til (‹⇧))
  octf (fork @oct @car (‹⇧))
  dolf (fork @dol (unicode ₹) (‹⇧))
  ampf (fork @amp @pip (‹⇧))
  ;; brackets' forks
  curf (fork @cuo @cuc (‹⇧))
  parf (fork @pao @pac (‹⇧))
  sqrf (fork [ (unshift ]) (‹⇧))
  ;; function keys' fn-forks
  1f   (fork 1 f1  (nop0))
  2f   (fork 2 f2  (nop0))
  3f   (fork 3 f3  (nop0))
  4f   (fork 4 f4  (nop0))
  5f   (fork 5 f5  (nop0))
  6f   (fork 6 f6  (nop0))
  7f   (fork 7 f7  (nop0))
  8f   (fork 8 f8  (nop0))
  9f   (fork 9 f9  (nop0))
  0f   (fork 0 f10 (nop0))
  astf (fork @ast f11 (nop0))
  perf (fork @per f12 (nop0))
)

;; TR (Thumb Right) layer
;; for symbols & numbers
(deflayer TR
  XX @excf @atsf @octf @dolf XX      @perf  @7f  @8f  @9f  @plu  @equf
  _   @ampf @sqrf @curf @parf XX    @astf  @4f  @5f  @6f  @hpnf   _
     XX    XX    @ano  @anc  XX       @0f   @1f  @2f  @3f  @slaf
              @tltltr _                      _ XX
)

;; screen control: tap locks the screen, hold turns the display off
;; (same keys as the QMK firmware where a shortcut exists)
(defvar
  thto 200
)
;; HID keyboard Power (0x66), same as QMK's KC_PWR; kanata only names it on Linux
(deflocalkeys-macos
  power 116
)
(platform (macos)
  (defalias
    ss C-M-q        ;; Lock Screen
    zz C-S-power    ;; display sleep
  )
)
(platform (linux)
  (defalias
    ss M-l                        ;; lock screen on GNOME/KDE
    zz (cmd xset dpms force off)  ;; X11 only; there's no common shortcut
  )
)
(platform (win winiov2 wintercept)
  (defalias
    ;; Win+L sent via SendInput doesn't lock, so call LockWorkStation directly
    ss (cmd rundll32.exe user32.dll,LockWorkStation)
    ;; no shortcut exists; broadcast SC_MONITORPOWER (off) with built-in PowerShell
    zz (cmd powershell -NoProfile -WindowStyle Hidden -Command r#"(Add-Type -MemberDefinition '[DllImport("user32.dll")] public static extern bool PostMessage(int h, int m, int w, int l);' -Name M -Namespace W -PassThru)::PostMessage(0xFFFF, 0x0112, 0xF170, 2)"#)
  )
)
(defalias
  scre (tap-hold $thto $thto @ss @zz)
)

;; brightness control
#| (defvirtualkeys
  brightness_up_key (unshift 🔆)
  brightness_down_key (unshift 🔅)
)
(defalias
  bri (tap-hold $thto $thto 🔆 (macro (on-press press-vkey brightness_up_key) 750 (on-press release-vkey brightness_up_key)))
  brl (tap-hold $thto $thto 🔅 (macro (on-press press-vkey brightness_down_key) 750 (on-press release-vkey brightness_down_key)))
) |#

;; media control
#| (platform (macos)
  (defalias
    voli (tap-hold $thto $thto 🔊 (macro (cmd $osa "set volume output volume 100") 275 (unshift 🔊)))
    voll (tap-hold $thto $thto 🔉 (macro (cmd $osa "set volume output volume 0") 275 (unshift 🔉)))
  )
)
(platform (linux)
  (defvar
    amixerMaster ("/usr/bin/amixer" "-D" "pulse" "sset" "Master")
  )
)
(platform (linux)
  (defalias
    voli (tap-hold $thto $thto 🔊 (cmd amixerMaster 100%))
    voll (tap-hold $thto $thto 🔉 (cmd amixerMaster 0%))
  )
)
(platform (win winiov2 wintercept)
  (defalias
    voli (tap-hold $thto $thto 🔊 (cmd nircmd setsysvolume 65535))
    voll (tap-hold $thto $thto 🔉 (cmd nircmd setsysvolume 0))
  )
) |#
(defalias
  pl (unshift pp)
  fo (unshift ▶▶)
  ba (unshift ◀◀)
)
(defalias
  med (tap-hold $thto $thto @pl @fo)
)

;; mouse & scroll control
(defvar
  rd $repeat_delay
  ;; mouse
  mo $mouse_move
  sm $slow_mouse_move
  pm $precise_mouse_move
  ;; scroll
  so $scroll_move
  ss $slow_scroll_move
  ps $precise_scroll_move
)
(environment (KANATA_RSCROLL "")
  (defalias
    ;; precise scroll
    sup (🖱☸↑ $rd $ps)
    sdp (🖱☸↓ $rd $ps)
    srp (🖱☸→ $rd $ps)
    slp (🖱☸← $rd $ps)
    ;; slow scroll
    sus (🖱☸↑ $rd $ss)
    sds (🖱☸↓ $rd $ss)
    srs (🖱☸→ $rd $ss)
    sls (🖱☸← $rd $ss)
    ;; scroll
    su (🖱☸↑ $rd $so)
    sd (🖱☸↓ $rd $so)
    sr (🖱☸→ $rd $so)
    sl (🖱☸← $rd $so)
    ;; zoom (Ctrl+wheel), same direction as the QMK firmware
    zmi (multi ‹⌃ (🖱☸↓ $rd $so))
    zmo (multi ‹⌃ (🖱☸↑ $rd $so))
  )
)
(environment (KANATA_RSCROLL "1")
  (defalias
    ;; precise scroll
    sup (🖱☸↓ $rd $ps)
    sdp (🖱☸↑ $rd $ps)
    srp (🖱☸← $rd $ps)
    slp (🖱☸→ $rd $ps)
    ;; slow scroll
    sus (🖱☸↓ $rd $ss)
    sds (🖱☸↑ $rd $ss)
    srs (🖱☸← $rd $ss)
    sls (🖱☸→ $rd $ss)
    ;; scroll
    su (🖱☸↓ $rd $so)
    sd (🖱☸↑ $rd $so)
    sr (🖱☸← $rd $so)
    sl (🖱☸→ $rd $so)
    ;; zoom
    zmi (multi ‹⌃ (🖱☸↑ $rd $so))
    zmo (multi ‹⌃ (🖱☸↓ $rd $so))
  )
)
(defalias
  ;; precise mouse
  mup (🖱↑ $rd $pm)
  mdp (🖱↓ $rd $pm)
  mrp (🖱→ $rd $pm)
  mlp (🖱← $rd $pm)
  ;; slow mouse
  mus (🖱↑ $rd $sm)
  mds (🖱↓ $rd $sm)
  mrs (🖱→ $rd $sm)
  mls (🖱← $rd $sm)
  ;; mouse
  mu (🖱↑ $rd $mo)
  md (🖱↓ $rd $mo)
  mr (🖱→ $rd $mo)
  ml (🖱← $rd $mo)
)
(defalias
  slw nop1
  pre nop2
  scr nop3
)
(defalias
  m△ (switch
    ((and nop1 nop2 nop3)) @sup break
    ((and nop1 nop3)) @sus break
    ((and nop1 nop2)) @mup break
    (nop1) @mus break
    (nop3) @su break
    () @mu break
  )
  m▽ (switch
    ((and nop1 nop2 nop3)) @sdp break
    ((and nop1 nop3)) @sds break
    ((and nop1 nop2)) @mdp break
    (nop1) @mds break
    (nop3) @sd break
    () @md break
  )
  m▻ (switch
    ((and nop1 nop2 nop3)) @srp break
    ((and nop1 nop3)) @srs break
    ((and nop1 nop2)) @mrp break
    (nop1) @mrs break
    (nop3) @sr break
    () @mr break
  )
  m◅ (switch
    ((and nop1 nop2 nop3)) @slp break
    ((and nop1 nop3)) @sls break
    ((and nop1 nop2)) @mlp break
    (nop1) @mls break
    (nop3) @sl break
    () @ml break
  )
)

;; TLTR (Thumb Left & Thumb Right) layer
;; for non-keyboard functions like mouse, media, screen etc.
(deflayer TLTR
  XX @scre 🔆  @med  🔊  🖰3       @zmi XX  @m△ XX  XX  XX
  XX  @pre @slw @scr  🖰1 🖰2       @zmo @m◅ @m▽ @m▻ XX   XX
     🖰5   🔅   @ba   🔉  🖰4         XX XX  XX  XX  XX
                XX _                    _ XX
)
